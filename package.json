{
  "name": "skyo",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "SKYO — Explorador astronómico multitemporal y laboratorio científico local-first (SPHEREx / JPL)",
  "main": "index.html",
  "scripts": {
    "sync:curated": "node scripts/sync-curated-manifest.mjs",
    "prestart": "npm run sync:curated",
    "start": "vite --host 127.0.0.1 --port 4173",
    "predev": "npm run sync:curated",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "pretest": "npm run sync:curated",
    "test": "node --test scripts/pipeline.test.mjs scripts/integrity.test.mjs scripts/session.test.mjs scripts/fits-boundary.test.mjs scripts/comparison.test.mjs scripts/science-regressions.test.mjs scripts/curated-dataset.test.mjs scripts/opfs.test.mjs scripts/wasm-equivalence.test.mjs scripts/fpa.test.mjs scripts/immersive.test.mjs scripts/l2.test.mjs",
    "audit:visual": "node scripts/audit-visual.mjs",
    "demo:generate": "node scripts/generate_demo_fits.mjs",
    "demo:preview": "node scripts/export_demo_preview.mjs",
    "wasm:build": "node scripts/build-wasm.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "web:build": "vite build && node tools/postbuild.mjs",
    "preweb:build": "npm run sync:curated",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "pretest:browser": "npm run sync:curated",
    "test:browser": "playwright test",
    "test:science-gaps": "node scripts/science-regressions.test.mjs",
    "test:curator": "python3 -m unittest discover -s tests -p test_curator.py",
    "validate:build": "node scripts/validate-build.mjs",
    "validate:docs": "node scripts/validate-docs.mjs"
  },
  "keywords": [
    "astronomy",
    "spherex",
    "fits",
    "webgl",
    "threejs",
    "space",
    "science",
    "nasa",
    "jpl",
    "local-first"
  ],
  "author": "aronemilio",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "vite": "7.3.8"
  },
  "dependencies": {
    "aladin-lite": "3.8.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
